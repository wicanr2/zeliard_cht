+package machine
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestReadBytesMatchesRead8AndSideEffects(t *testing.T) {
+	for _, planar := range []bool{false, true} {
+		for _, span := range []struct {
+			a uint32
+			n int
+		}{{0, 1 << 20}, {0x1b10, 65536}, {vgaLo - 8, 32}, {vgaHi - 8, 32}, {0xffff0, 64}, {0x100010, 32}, {0, 0}} {
+			for _, watched := range []bool{false, true} {
+				a, b := New(), New()
+				a.planarOn = planar
+				b.planarOn = planar
+				for i := range a.Mem {
+					a.Mem[i] = byte(i*37 + i/256)
+					b.Mem[i] = a.Mem[i]
+				}
+				var wa, wb []uint32
+				if watched {
+					a.WatchReads(0x1000, 0x2000, func(at uint32, v uint8) { wa = append(wa, at) })
+					b.WatchReads(0x1000, 0x2000, func(at uint32, v uint8) { wb = append(wb, at) })
+				}
+				got := a.ReadBytes(span.a, span.n)
+				want := make([]byte, span.n)
+				for i := range want {
+					want[i] = b.Read8(span.a + uint32(i))
+				}
+				if !reflect.DeepEqual(got, want) || !reflect.DeepEqual(wa, wb) || !reflect.DeepEqual(a.VGA, b.VGA) {
+					t.Fatalf("planar=%v watched=%v addr=%x n=%d", planar, watched, span.a, span.n)
+				}
+				if len(got) > 0 {
+					got[0] ^= 255
+					if a.Read8(span.a) != b.Read8(span.a) {
+						t.Fatal("snapshot aliases machine memory")
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestReadBytesReadWatchMutatesLaterRAM(t *testing.T) {
+	a, b := New(), New()
+	a.WatchReads(0x1800, 0x1800, func(at uint32, v uint8) { a.Mem[0x4000] = 99 })
+	b.WatchReads(0x1800, 0x1800, func(at uint32, v uint8) { b.Mem[0x4000] = 99 })
+	got := a.ReadBytes(0, 0x5000)
+	want := make([]byte, 0x5000)
+	for i := range want {
+		want[i] = b.Read8(uint32(i))
+	}
+	if !reflect.DeepEqual(got, want) || got[0x4000] != 99 {
+		t.Fatal("watch side effects must precede later bulk copies")
+	}
+}
+
+func TestReadBytesWatchCanMoveDuringRead(t *testing.T) {
+	a, b := New(), New()
+	var wa, wb []uint32
+	a.WatchReads(0x1800, 0x1800, func(at uint32, v uint8) {
+		wa = append(wa, at)
+		a.WatchReads(0x3000, 0x3000, func(at uint32, v uint8) { wa = append(wa, at) })
+	})
+	b.WatchReads(0x1800, 0x1800, func(at uint32, v uint8) {
+		wb = append(wb, at)
+		b.WatchReads(0x3000, 0x3000, func(at uint32, v uint8) { wb = append(wb, at) })
+	})
+	got := a.ReadBytes(0, 0x5000)
+	want := make([]byte, 0x5000)
+	for i := range want {
+		want[i] = b.Read8(uint32(i))
+	}
+	if !reflect.DeepEqual(got, want) || !reflect.DeepEqual(wa, wb) || len(wa) != 2 {
+		t.Fatal("watch boundary change was lost", wa, wb)
+	}
+}
