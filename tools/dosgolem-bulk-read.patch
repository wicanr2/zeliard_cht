+package machine
+
+// ReadBytes returns an independent snapshot in Read8 order. Ordinary spans use
+// bulk copies. Recompute watched/planar boundaries after each side-effecting read
+// because a read callback may change watches, VGA mode or later RAM.
+func (m *Machine) ReadBytes(a uint32, n int) []byte {
+	out := make([]byte, n)
+	end := uint64(a) + uint64(n)
+	if end > 1<<20 {
+		for i := range out {
+			out[i] = m.Read8(a + uint32(i))
+		}
+		return out
+	}
+	for at := uint64(a); at < end; {
+		next := end
+		read := false
+		if m.onRead != nil && m.rWatchLo <= m.rWatchHi {
+			lo, hi := uint64(m.rWatchLo), uint64(m.rWatchHi)+1
+			if at >= lo && at < hi {
+				read = true
+			} else if at < lo && lo < next {
+				next = lo
+			}
+		}
+		if m.planarOn {
+			if at >= uint64(vgaLo) && at < uint64(vgaHi) {
+				read = true
+			} else if at < uint64(vgaLo) && uint64(vgaLo) < next {
+				next = uint64(vgaLo)
+			}
+		}
+		if read {
+			out[at-uint64(a)] = m.Read8(uint32(at))
+			at++
+		} else {
+			copy(out[at-uint64(a):next-uint64(a)], m.Mem[at:next])
+			at = next
+		}
+	}
+	return out
+}
