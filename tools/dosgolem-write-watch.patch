+package oracle
+
+import "github.com/wicanr2/dosgolem/internal/machine"
+
+// WatchEveryWrite 監看 [lo, hi] 線性位址的每一次位元組寫入，寫入相同的值也通知，
+// 回傳 UnwatchWrite 用的 id。WatchWritesAt 只在值改變時通知，
+// 回答不了「這一點是否被覆寫成同一個值」。
+func (o *Oracle) WatchEveryWrite(lo, hi uint32, fn func(addr uint32, old, val uint8)) int {
+	return o.m.WatchWrite(lo, hi, func(_ *machine.Machine, a uint32, old, v uint8) { fn(a, old, v) })
+}
+
+// UnwatchWrite 拿掉 WatchEveryWrite 的監看；id 不存在時不做事。
+func (o *Oracle) UnwatchWrite(id int) { o.m.Unwatch(id) }
